+      // ② 长对话（20 条 > 上限 8）：两次都不该"提到首位"，且应记"跳过"
+      const before = promotedShort;
+      await call({ port: gw.port, p: '/v1/chat/completions', body: { model: 'test-model', messages: many }, headers: sess });
+      await call({ port: gw.port, p: '/v1/chat/completions', body: { model: 'test-model', messages: many }, headers: sess });
+      const log2 = fs.readFileSync(gw.logPath, 'utf8');
